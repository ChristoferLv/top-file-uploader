generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}

model users {
  id       Int     @id @default(autoincrement())
  username String  @unique
  password String
  name     String?
  files    files[]
}

model files {
  id      Int     @id @default(autoincrement())
  title   String
  content String?
  owner   users   @relation(fields: [ownerId], references: [id])
  ownerId Int
}
