generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}

model users {
  id       Int       @id @default(autoincrement())
  username String    @unique
  password String
  files    files[]
  folders  folders[]
}

model folders {
  id         Int          @id @default(autoincrement())
  title      String
  created_at DateTime     @default(now())
  owner      users        @relation(fields: [ownerId], references: [id])
  ownerId    Int
  files      files[]
  share_link share_links?
}

model files {
  id          Int      @id @default(autoincrement())
  title       String
  mime        String
  content     String   @db.Text
  size        Int
  uploaded_at DateTime @default(now())
  owner       users    @relation(fields: [ownerId], references: [id])
  ownerId     Int
  folders     folders? @relation(fields: [folderId], references: [id])
  folderId    Int?
}

model share_links {
  id         Int      @id @default(autoincrement())
  created_at DateTime @default(now())
  expires_at DateTime @default(now())
  folder     folders  @relation(fields: [folderId], references: [id])
  folderId   Int      @unique
}
