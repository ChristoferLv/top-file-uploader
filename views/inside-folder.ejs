<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">
    <title>Drove</title>
</head>

<body>
    <%- include("partials/header.ejs") %>
        <div class="folder-header">
            <div class="new-folder-container">
                <h3>Upload File</h3>
                <form action="/files/upload-on-folder/<%=folderId %>" method="POST" enctype="multipart/form-data">
                    <input type="file" name="fileContent" />
                    <input type="submit" value="Send">
                </form>
            </div>
            <div class="new-folder-container">
                <h3>Actions</h3>
                <input type="button" onclick="showDialog()" value="Rename Folder"/>
                <form action="/folder/<%=folderId %>/delete" method="post">
                    <input type="submit" value="Delete Folder"/>
                </form>
            </div>
        </div>
        <h1 class="home-heading">Files in <%= locals.name %>:
        </h1>
        <div class="messages">
            <% files.map((file)=> { %>
                <a class="message-card-a" href="/files/file/<%=file.id %>">
                    <div id=<%=file.id %> class="message-card">
                        <p>
                            <strong>
                                <%= file.title %>
                            </strong>
                        </p>
                        <hr>
                        <% if (file.type=="image" ) {%>
                            <% const imagData=`data:${file.mime};base64, ${file.content}` %>
                                <img src='<%-imagData %>' alt="">
                                <% }else if(file.type=="text" ){ %>
                                    <div class="multi-line-truncate text-preview">
                                        <%= file.content %>
                                    </div>
                                    <%}else{%>
                                        <p>File preview not available</p>
                                        <%}%>
                                            <form action="/files/download/<%= file.id %>" method="get">
                                                <input type="submit" value="Download">
                                            </form>
                    </div>
                </a>
                <% }) %>
        </div>



        <dialog id="update-name-dialog">
            <% if(locals.recoveredValues) { %>
                <%- include("partials/errors.ejs") %>
                    <% } %>
                        <form id="updateName" method="POST" action="/folder/<%= locals.folderId %>/rename">
                            <label for="name">New name</label>
                            <input id="name" name="name" type="text">
                            <input type="submit" value="Save">
                        </form>
                        <button onclick="closeDialog()">Close</button>
        </dialog>


        <script>
            const myFormDialog = document.getElementById('update-name-dialog');
            const updateForm = document.getElementById('updateName');
            const name = myFormDialog.querySelector("#name");

            let recovered = null;

            recovered = '<%- locals.recoveredName %>'

            if (recovered) {
                name.value = recovered;
            }

            function closeDialog() {
                myFormDialog.close();
            }

            function showDialog() {
                name.value = '<%- locals.name %>';
                myFormDialog.showModal();
            }
        </script>
</body>

</html>