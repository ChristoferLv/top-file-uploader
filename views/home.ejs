<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">
    <title>Drove</title>
</head>

<body>
    <%- include("partials/header.ejs") %>
        <h1>Your files</h1>
        <div class="messages">
            <% files.map((file)=> { %>
                <div id=<%=file.id %> class="message-card">
                    <p>
                        <%= file.title %>
                    </p>
                    <% if (file.type=="image" ) {%>
                        <% const imagData=`data:${file.mime};base64, ${file.content}` %>
                            <img src='<%-imagData %>' alt="">
                            <% }else if(file.type=="text" ){ %>
                                <div class="multi-line-truncate text-preview">
                                    <%= file.content %>
                                </div>
                                <%}else{%>
                                    <p>File preview not available</p>
                                    <%}%>
                </div>
                <% }) %>
        </div>
</body>

</html>