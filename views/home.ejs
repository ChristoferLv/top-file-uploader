<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">
    <title>Drove</title>
</head>

<body>
    <%- include("partials/header.ejs") %>
        <h1 class="home-heading">Files in <%= locals.name %>:
        </h1>
        <div class="messages">
            <% files.map((file)=> { %>
                <a class="message-card-a" href="/file/<%=file.id %>">
                    <div id=<%=file.id %> class="message-card file">
                        <p>
                            <strong>
                                <%= file.title %>
                            </strong>
                        </p>
                    </div>
                </a>
                <% }) %>
        </div>
</body>

</html>