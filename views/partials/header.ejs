<header>
    <a href="/">
        <p>Drove Files 🗃️</p>
    </a>
    <% if (locals.user) {%>
        <div class="header-actions">
            <a href="/auth/log-out" class="header-action-item">LOG OUT</a>
        </div>
        <% } %>
            <% if (!locals.user) {%>
                <div class="header-actions">
                    <a href="/auth/log-in" class="header-action-item">LOG IN</a>
                    <a href="/auth/sign-up" class="header-action-item">SIGN UP</a>
                </div>
                <% } %>
</header>